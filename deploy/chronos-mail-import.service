[Unit]
Description=Chronos — import des courriels transférés (Microsoft Graph)
After=network-online.target chronos-env-fetch.service postgresql.service
Requires=chronos-env-fetch.service

[Service]
Type=oneshot
User=django
Group=www-data
UMask=0027
WorkingDirectory=/var/www/django_websites/Chronos
EnvironmentFile=/run/chronos/.env
# Le SHA déployé (SENTRY_RELEASE), écrit par root au déploiement ; absent avant le premier.
EnvironmentFile=-/var/lib/fleet-deploy/Chronos.release.env
ExecStart=/var/www/django_websites/Chronos/.venv/bin/python manage.py importer_courriels
TimeoutStartSec=900
NoNewPrivileges=yes
