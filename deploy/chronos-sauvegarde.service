[Unit]
Description=Chronos — sauvegarde vérifiée de la base (pg_dump) et des pièces
After=network-online.target chronos-env-fetch.service postgresql.service
Requires=chronos-env-fetch.service

[Service]
Type=oneshot
User=django
Group=www-data
UMask=0077
WorkingDirectory=/var/www/django_websites/Chronos
EnvironmentFile=/run/chronos/.env
# `manage.py sauvegarder` : pg_dump au format personnalisé + copie intégrale
# des pièces + manifeste SHA-256, relu avant d'être validé, rotation à 14.
ExecStart=/var/www/django_websites/Chronos/.venv/bin/python manage.py sauvegarder --destination /var/backups/chronos --garder 14
ProtectSystem=strict
ReadWritePaths=/var/backups/chronos
NoNewPrivileges=yes
TimeoutStartSec=1800
